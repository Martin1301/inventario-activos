generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * =========================================
 * USER
 * =========================================
 */
model User {
  id       Int    @id @default(autoincrement())
  nombre   String
  email    String @unique
  password String
  role     Role

  /**
   * LOCAL ASIGNADO
   */
  localId Int?

  local Local? @relation(fields: [localId], references: [id])

  /**
   * GUIAS
   */
  guidesEnviadas  Guide[] @relation("GuideSentBy")

  guidesRecibidas Guide[] @relation("GuideReceivedBy")

  guidesEncargado Guide[] @relation("GuideEncargado")

  createdAt DateTime @default(now())
}

/**
 * =========================================
 * LOCAL
 * =========================================
 */
model Local {
  id         Int    @id @default(autoincrement())
  nombre     String
  direccion  String
  red        String

  /**
   * RELACIONES
   */
  users  User[]
  assets Asset[]

  /**
   * GUIAS
   */
  origenGuides  Guide[] @relation("GuideOrigen")

  destinoGuides Guide[] @relation("GuideDestino")

  createdAt DateTime @default(now())
}

/**
 * =========================================
 * AREA
 * =========================================
 */
model Area {
  id     Int    @id @default(autoincrement())
  nombre String

  assets Asset[]

  createdAt DateTime @default(now())
}

/**
 * =========================================
 * FACTURAS
 * =========================================
 */
model Invoice {
  id            Int    @id @default(autoincrement())
  numeroFactura String
  proveedor     String
  detalles      String?
  fecha         DateTime

  assets Asset[]

  createdAt DateTime @default(now())
}

/**
 * =========================================
 * ACTIVOS
 * =========================================
 */
model Asset {
  id            Int    @id @default(autoincrement())
  codigo        String @unique
  serie         String
  dispositivo   String
  marca         String
  modelo        String
  categoria     AssetCategory
  observaciones String?
  ip            String?

  /**
   * ESTADO
   */
  estado AssetState

  /**
   * UBICACIÓN
   */
  areaId Int?

  area Area? @relation(fields: [areaId], references: [id])

  localId Int?

  local Local? @relation(fields: [localId], references: [id])

  otherLocation String?

  /**
   * FACTURA
   */
  invoiceId Int?

  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  /**
   * RELACIONES
   */
  guideDetails GuideDetail[]

  movements Movement[]

  createdAt DateTime @default(now())
}

/**
 * =========================================
 * GUIAS
 * =========================================
 */
model Guide {
  id            Int    @id @default(autoincrement())
  numero        String @unique
  estado        GuideState
  observaciones String?

  /**
   * ORIGEN
   */
  origenTipo LocationType

  origenLocalId Int?

  origenLocal Local? @relation("GuideOrigen", fields: [origenLocalId], references: [id])

  /**
   * DESTINO
   */
  destinoTipo DestinationType

  destinoLocalId Int?

  destinoLocal Local? @relation("GuideDestino", fields: [destinoLocalId], references: [id])

  otroDestino String?

  /**
   * RESPONSABLE
   */
  encargadoTipo ResponsableType

  /**
   * USUARIO CENTRAL RESPONSABLE
   * DEL TRASLADO
   */
  encargadoUserId Int?

  encargadoUser User? @relation("GuideEncargado", fields: [encargadoUserId], references: [id])

  /**
   * QUIEN ENVIA
   */
  enviadoPorId Int?

  enviadoPor User? @relation("GuideSentBy", fields: [enviadoPorId], references: [id])

  /**
   * QUIEN RECIBE
   */
  recibidoPorId Int?

  recibidoPor User? @relation("GuideReceivedBy", fields: [recibidoPorId], references: [id])

  /**
   * FECHAS
   */
  fechaEnvio     DateTime @default(now())
  fechaRecepcion DateTime?

  /**
   * RELACIONES
   */
  details   GuideDetail[]
  movements Movement[]

  createdAt DateTime @default(now())
}

/**
 * =========================================
 * DETALLE GUIA
 * =========================================
 */
model GuideDetail {
  id Int @id @default(autoincrement())

  guideId Int

  guide Guide @relation(fields: [guideId], references: [id])

  assetId Int

  asset Asset @relation(fields: [assetId], references: [id])

  /**
   * RECEPCIÓN INDIVIDUAL
   */
  estado GuideDetailState @default(ENVIADO)

  recibido Boolean @default(false)

  observaciones String?

  createdAt DateTime @default(now())
}

/**
 * =========================================
 * MOVIMIENTOS
 * =========================================
 */
model Movement {
  id Int @id @default(autoincrement())

  assetId Int

  asset Asset @relation(fields: [assetId], references: [id])

  origen String

  destino String

  observacion String?

  guideId Int?

  guide Guide? @relation(fields: [guideId], references: [id])

  fecha DateTime @default(now())
}

/**
 * =========================================
 * ENUMS
 * =========================================
 */

enum Role {
  CENTRAL
  LOCAL
}

enum AssetState {
  STOCK
  EN_USO
  MALOGRADO
  TRANSITO
  BAJA
}

enum AssetCategory {
  CPU
  MONITOR
  IMPRESORA
  SWITCH_ROUTER
  LECTORA
  CELULAR
  TABLET
  TECLADO
  MOUSE
  GAVETA
  CAMARAS
  OTROS
}

enum GuideState {
  BORRADOR
  GENERADA
  TRANSITO
  RECIBIDA
  PARCIAL
}

enum GuideDetailState {
  ENVIADO
  RECIBIDO
  FALTANTE
}

enum LocationType {
  CENTRAL
  LOCAL
  OTROS
}

enum DestinationType {
  CENTRAL
  LOCAL
  OTROS
}

enum ResponsableType {
  SOPORTE
  TRANSPORTE
}